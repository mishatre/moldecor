{
    "name": "moldecor",
    "version": "2.0.0-rc.0",
    "description": "Type-safe standard decorators for Moleculer services and mixins",
    "keywords": [
        "moleculer",
        "decorators",
        "typescript",
        "microservices",
        "mixins"
    ],
    "author": "Mikhail Tregub",
    "license": "MIT",
    "homepage": "https://github.com/mishatre/moldecor#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mishatre/moldecor.git"
    },
    "bugs": {
        "url": "https://github.com/mishatre/moldecor/issues"
    },
    "type": "module",
    "sideEffects": [
        "./dist/index.mjs",
        "./dist/index.cjs"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "format": "biome check --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "check:package": "publint && node scripts/check-types.mjs && node scripts/check-package.mjs",
        "check": "biome ci . && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run check:package",
        "prepack": "pnpm run build"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.22.0",
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "moleculer": "^0.14.35 || ^0.15.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "2.5.10",
        "@types/node": "^22.20.1",
        "@vitest/coverage-v8": "^4.1.11",
        "moleculer": "0.15.1",
        "publint": "^0.3.24",
        "tsdown": "^0.22.14",
        "typescript": "5.9.3",
        "vitest": "^4.1.11"
    }
}
